# =============================================================================
# Decepticon — Environment Variables
# =============================================================================
# The installer copies this file to ~/.decepticon/.env
# Edit with: decepticon config

# --- LLM API Keys ---
# Required: At least one API key OR OpenRouter key

# Direct Provider APIs (traditional approach)
ANTHROPIC_API_KEY=your-anthropic-key-here
OPENAI_API_KEY=your-openai-key-here
# GOOGLE_API_KEY=your-google-key-here
# MINIMAX_API_KEY=your-minimax-key-here

# OpenRouter (unified gateway to 200+ models)
# Get your key at: https://openrouter.ai/keys
# Provides access to Anthropic, OpenAI, Google, Meta, Mistral, Cohere, and more
# Often 10-30% cheaper than direct APIs with unified billing
# OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Local LLM (Ollama)
# OLLAMA_MODEL=llama3.2
# OLLAMA_API_BASE=http://localhost:11434

# --- LiteLLM Proxy ---
LITELLM_MASTER_KEY=sk-decepticon-master
LITELLM_SALT_KEY=sk-decepticon-salt-change-me

# --- PostgreSQL ---
POSTGRES_PASSWORD=decepticon

# --- Neo4j (Attack Chain Graph DB) ---
# Used when DECEPTICON_KG_BACKEND=neo4j
NEO4J_PASSWORD=decepticon-graph

# --- Model Profile ---
# eco  = Balanced (Opus/Sonnet/Haiku mix, recommended)
# max  = Maximum performance (Opus everywhere, expensive)
# test = Cheapest (Haiku-only, for development)
DECEPTICON_MODEL_PROFILE=eco

# --- Model Provider ---
# Controls how models are accessed and authenticated:
#
# api        = Direct provider APIs with API keys (default)
#              Uses ANTHROPIC_API_KEY, OPENAI_API_KEY, etc.
#              Standard approach, best rate limits per provider
#
# auth       = Claude Code OAuth subscription (Bearer token, no API cost)
#              Routes Anthropic models through OAuth, others via API keys
#              Requires Claude Code subscription
#
# openrouter = OpenRouter unified gateway (single API key for all models)
#              Routes ALL models through OpenRouter using OPENROUTER_API_KEY
#              Access to 200+ models, unified billing, often 10-30% cheaper
#              Requires OPENROUTER_API_KEY
#
# hybrid     = Mixed strategy (direct Anthropic + OpenRouter for others)
#              Keeps Anthropic on direct API for best rate limits
#              Routes other models (GPT, Gemini, Llama, Mistral) via OpenRouter
#              Requires both ANTHROPIC_API_KEY and OPENROUTER_API_KEY
#              Optimal for cost savings while maintaining Anthropic performance
#
DECEPTICON_MODEL_PROVIDER=api

# --- Custom Model Selection (optional) ---
# Override specific agent models while keeping the base profile for others.
# Useful for testing new models or optimizing cost/performance per agent role.
#
# Format: DECEPTICON_MODEL_<ROLE>=<model-name>
#         DECEPTICON_MODEL_<ROLE>_FALLBACK=<fallback-model-name>
#
# Supported agent roles:
#   Strategic tier:    decepticon, soundwave
#   Precision tier:    exploit, analyst, reverser, contract_auditor, cloud_hunter, ad_operator
#   Tactical tier:     recon, postexploit, defender
#   Vulnresearch tier: vulnresearch, scanner, detector, verifier, patcher, exploiter
#
# Examples with OpenRouter models:
#
# Use Llama 70B for recon (cost-effective, fast)
# DECEPTICON_MODEL_RECON=openrouter/meta-llama/llama-3.1-70b-instruct
# DECEPTICON_MODEL_RECON_FALLBACK=openrouter/google/gemini-flash-1.5
#
# Use Opus for exploit (maximum precision)
# DECEPTICON_MODEL_EXPLOIT=openrouter/anthropic/claude-opus-4-6
# DECEPTICON_MODEL_EXPLOIT_FALLBACK=openrouter/anthropic/claude-sonnet-4-6
#
# Use Mistral Large for analyst (good reasoning, lower cost)
# DECEPTICON_MODEL_ANALYST=openrouter/mistralai/mistral-large
# DECEPTICON_MODEL_ANALYST_FALLBACK=openrouter/anthropic/claude-sonnet-4-6
#
# Use GPT-4o for soundwave (structured output)
# DECEPTICON_MODEL_SOUNDWAVE=openrouter/openai/gpt-4o
#
# Use Command R+ for postexploit (tool use specialist)
# DECEPTICON_MODEL_POSTEXPLOIT=openrouter/cohere/command-r-plus
#
# Mix direct API and OpenRouter models:
# DECEPTICON_MODEL_DECEPTICON=anthropic/claude-opus-4-6
# DECEPTICON_MODEL_RECON=openrouter/meta-llama/llama-3.1-70b-instruct
# DECEPTICON_MODEL_EXPLOIT=openrouter/anthropic/claude-sonnet-4-6
#
# Note: Model overrides are applied BEFORE provider remapping.
# If DECEPTICON_MODEL_PROVIDER=openrouter, all models (including overrides)
# will be routed through OpenRouter.

# --- LangSmith Tracing (optional) ---
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=your-langsmith-key-here
# LANGSMITH_PROJECT=decepticon

# --- Ports (optional) ---
# LANGGRAPH_PORT=2024
# LITELLM_PORT=4000
# POSTGRES_PORT=5432
# WEB_PORT=3000

# --- C2 Framework ---
# Default C2 server profile. Change to swap C2 frameworks.
# Options: c2-sliver (default), c2-havoc (future)
COMPOSE_PROFILES=c2-sliver

# --- Paths ---
# Install directory (used for workspace bind mount into containers).
# - Production: The installer sets this to ~/.decepticon automatically.
# - Development: `decepticon` (Python entry point) sets this to the repo root automatically.
# Do not use ~ (tilde) — Docker Compose cannot expand it.
# DECEPTICON_HOME=/home/youruser/.decepticon

# --- Advanced (optional) ---
# Disable automatic self-update checks on startup
# AUTO_UPDATE=false
# DECEPTICON_DEBUG=true
